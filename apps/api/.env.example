# --- apps/api ---
# Copy to .env and fill in. .env is gitignored; never commit real secrets.

NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173
# Pino log level: fatal|error|warn|info|debug|trace|silent (default info)
LOG_LEVEL=info

# Postgres connection (Phase 1+). On Supabase, the direct host
# (db.<ref>.supabase.co:5432) is IPv6-only; on an IPv4 network use the Supavisor
# pooler connection string instead (aws-0-<region>.pooler.supabase.com).
DATABASE_URL=
# Runtime connection for the API + tests. Connect as the least-privilege role
# `docpilot_app` (NOBYPASSRLS) so RLS is actually enforced — `postgres` has
# BYPASSRLS and would skip every policy. Create it once with:
#   APP_DB_PASSWORD=... node scripts/setup-app-role.mjs && node scripts/write-app-url.mjs
APP_DATABASE_URL=
# Optional: a throwaway Postgres for the tenant-isolation test (falls back to
# APP_DATABASE_URL). RLS is a real Postgres feature, so the test needs a live DB.
# TEST_DATABASE_URL=
# DIRECT_URL=
# Redis for the BullMQ ingestion queue/worker (Phase 2). Upstash (rediss://...)
# or local redis://localhost:6379. Uploads return 503 until this is set.
# REDIS_URL=

# Auth
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=
# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_TTL=7d

# Storage (lib/storage). Default driver `local` writes to STORAGE_DIR (dev only).
# STORAGE_DRIVER=local
# STORAGE_DIR=.uploads
# For STORAGE_DRIVER=s3 (Cloudflare R2 / AWS S3) also run: pnpm --filter api add @aws-sdk/client-s3
# STORAGE_ENDPOINT=
# STORAGE_BUCKET=
# STORAGE_REGION=auto
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=

# Embeddings (lib/llm). `fake` = deterministic dev driver (no key/cost).
# EMBEDDING_PROVIDER=fake
# EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_API_KEY=

# LLM for chat (Phase 3)
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# Uploads
# MAX_UPLOAD_MB=25

# Per-workspace rate limits (fixed 60s window, Redis-backed; fail open if Redis is down)
# RATE_LIMIT_CHAT_PER_MIN=30
# RATE_LIMIT_UPLOAD_PER_MIN=20

# SENTRY_DSN=
